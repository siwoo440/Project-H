          "preferred": false,
          "next": "v4b"
        }
      ]
    },
    {
      "id": "v4a",
      "speaker": "CH_NOEL",
      "expression": "미소",
      "text": "정말요? 그럼… 이번엔 둘이 그린 지도네요.",
