        {
          "text": "일이 아니라고 답한다",
          "affinity": 2,
          "preferred": true,
          "next": "i4a"
        },
        {
          "text": "정하지 말자고 한다",
          "affinity": 1,
          "preferred": false,
          "next": "i4b"
        }
      ]
    },
    {
      "id": "i4a",
      "speaker": "CH_LUCIA",
      "expression": "미소",
      "text": "…그럼 값은 못 받겠네. 들어와.",
